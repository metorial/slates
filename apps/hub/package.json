{
  "name": "slates-hub",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun ./src/server.ts",
    "start:watch": "bun --watch ./src/server.ts",
    "dev": "docker compose -p slates-hub -f ./docker-compose.dev.yml up -d",
    "dev:stop": "docker compose -p slates-hub -f ./docker-compose.dev.yml down",
    "dev:logs": "docker compose -p slates-hub -f ./docker-compose.dev.yml logs -f",
    "dev:restart": "docker compose -p slates-hub -f ./docker-compose.dev.yml restart",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/lodash": "^4.17.23",
    "vitest": "4.0.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-iam": "^3.957.0",
    "@aws-sdk/client-lambda": "^3.958.0",
    "@hono/zod-validator": "^0.7.6",
    "@lowerdeck/api-key": "^1.0.1",
    "@lowerdeck/api-mux": "^1.0.1",
    "@lowerdeck/cache": "^1.0.0",
    "@lowerdeck/canonicalize": "^1.0.4",
    "@lowerdeck/cron": "^1.0.4",
    "@lowerdeck/delay": "^1.0.4",
    "@lowerdeck/encryption": "^1.0.6",
    "@lowerdeck/env": "^1.0.4",
    "@lowerdeck/error": "^1.0.10",
    "@lowerdeck/hash": "^1.0.4",
    "@lowerdeck/hono": "^1.0.6",
    "@lowerdeck/id": "^1.0.5",
    "@lowerdeck/lock": "^1.0.4",
    "@lowerdeck/once": "^1.0.4",
    "@lowerdeck/pagination": "^1.0.4",
    "@lowerdeck/queue": "^1.0.4",
    "@lowerdeck/rpc-client": "^1.0.2",
    "@lowerdeck/rpc-server": "^1.0.5",
    "@lowerdeck/sentry": "^1.0.2",
    "@lowerdeck/serialize": "^1.0.4",
    "@lowerdeck/service": "^1.0.3",
    "@lowerdeck/shadow-id": "^1.0.7",
    "@lowerdeck/slugify": "^1.0.4",
    "@lowerdeck/validation": "^1.0.4",
    "@metorial-services/function-bay-client": "1.0.3",
