enum SecretStatus {
  active
  deleted
}

enum SecretType {
  slate_authentication_configuration
}

model Secret {
  oid    BigInt       @id
  id     String       @unique
  type   SecretType
  status SecretStatus

  tenantOid BigInt
  tenant    Tenant @relation(fields: [tenantOid], references: [oid], onDelete: Cascade)

  encryptedSecret String

  createdAt DateTime @default(now())

  secretAccesses SecretAccess[]
}

enum SecretAccessType {
  decrypt_for_slate_launch
}

model SecretAccess {
  oid BigInt @id

  accessType SecretAccessType

  secretOid BigInt
  secret    Secret @relation(fields: [secretOid], references: [oid], onDelete: Cascade)

  createdAt DateTime @default(now())
}
