{
  "name": "slates-registry",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun ./src/server.ts",
    "dev": "docker compose -p slates-registry -f ./docker-compose.dev.yml up --pull always --build slates-registry object-storage",
    "build:admin": "vite build --config admin/vite.config.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit",
